# ==========================================
# Kisan Setu — Backend Environment Configuration
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas for Production, local for Dev)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/kisan-setu?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/kisan-setu

# JWT Authentication Secret
JWT_SECRET=kisan_setu_production_jwt_super_secret_key_2026

# Google Gemini Multi-Modal AI API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Get at https://openweathermap.org/api)
WEATHER_API_KEY=your_openweather_api_key_here

# Government Mandi AGMARKNET API Key (Data.gov.in)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
MARKET_API_KEY=your_data_gov_in_api_key_here

# Frontend Client URL for CORS (Set to your deployed frontend domain)
# Example: https://kisan-setu.vercel.app
CLIENT_URL=http://localhost:5173
