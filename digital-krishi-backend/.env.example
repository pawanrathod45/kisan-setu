# ==========================================
# Kisan Setu — Backend Environment Config
# ==========================================

PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/kisan-setu

# JWT Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Google Gemini 2.5 Multi-Modal AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Government Mandi & AGMARKNET API (Data.gov.in)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
