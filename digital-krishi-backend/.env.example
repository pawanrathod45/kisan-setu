# ============================================
# KISAN SETU BACKEND — ENVIRONMENT TEMPLATE
# ============================================

PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas for Production, local for Dev)
# In Render Dashboard: set to your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kisan-setu?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Get at https://openweathermap.org/api)
WEATHER_API_KEY=your_openweather_api_key_here

# Government Mandi AGMARKNET API Key (Data.gov.in)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
MARKET_API_KEY=your_data_gov_in_api_key_here

# Frontend Client URL for CORS (Set to your Vercel frontend domain in Render)
# Example: https://kisan-setu.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app

# Email Service Configuration (Resend API or SMTP e.g. Gmail App Password, Brevo, SendGrid)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Kisan Setu <onboarding@resend.dev>

# Fallback SMTP Configuration (Gmail App Password, Brevo, SendGrid, Amazon SES)
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=no-reply@kisansetu.com

