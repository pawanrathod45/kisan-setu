# ==========================================
# Kisan Setu — Frontend Environment Configuration
# ==========================================

# 1. Local Development
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# 2. Production Deployment (Replace with your actual Render backend URL)
# Example: VITE_API_URL=https://kisan-setu-backend.onrender.com/api
# VITE_API_URL=https://YOUR_RENDER_BACKEND_URL.onrender.com/api
# VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND_URL.onrender.com/api

# Optional Client-side Direct API Keys (Backend provides these automatically)
VITE_WEATHER_API_KEY=
